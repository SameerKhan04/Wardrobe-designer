{
  "expo": {
    "name": "Wardrobe",
    "slug": "wardrobe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wardrobe",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F0E6",
    "ios": {
      "bundleIdentifier": "com.sameerkhan.wardrobe",
      "supportsTablet": false
    },
    "android": {
      "package": "com.sameerkhan.wardrobe",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withMlkitModels.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F0E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Wardrobe uses the camera to photograph your clothes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wardrobe lets you pick photos of your clothes.",
          "cameraPermission": "Wardrobe uses the camera to photograph your clothes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wardrobe uses your location once, when you ask, to fetch the weather.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bbf20b1d-9574-44e7-8152-9c4fba0d457f"
      }
    },
    "owner": "sameerk04"
  }
}
